# Body: 2-run BM topology inference with LIVE convergence stopping rules, replacing the
# old fixed-nGen + post-hoc ASDSF protocol. Convergence is judged by (i) tree-ESS post-hoc
# (treess, in R) and (ii) Gelman-Rubin PSRF (R-hat) on the scalar parameter trace (.p.log),
# enforced here by srGelmanRubin + srMinESS on that file (mirrors MkPrime run-mcmcmc.Rev).
# Runs self-terminate when PSRF <= 1.01 AND ESS >= 333 (or maxHours elapses). Writes
# _run_1/_run_2 .trees + .p.log traces and per-run MAP (_map1/_map2). Used for BOTH the
# continuous grid and the geometric shape coords (both are continuous character data).
# Expects (header): inNex, outPre; optional maxHours (default 2). (nGen no longer used.)
data  = readContinuousCharacterData(inNex)
nC    = data.nchar()
taxa  = data.taxa()
nTaxa = taxa.size()
nEdge = 2 * nTaxa - 3
moves = VectorMoves(); monitors = VectorMonitors()

topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight = nEdge / 1.0) )     # doubled vs main grid
moves.append( mvSPR(topology, weight = nEdge / 4.0) )     # doubled vs main grid
tree_length ~ dnGamma(shape = 2, rate = 2)
moves.append( mvScale(tree_length, weight = 1.0) )
rel_br_lengths ~ dnDirichlet( rep(1.0, nEdge) )
moves.append( mvBetaSimplex(rel_br_lengths, weight = nEdge / 3.0) )
moves.append( mvDirichletSimplex(rel_br_lengths, weight = nEdge / 20.0) )
br_lengths := rel_br_lengths * tree_length
phylogeny := treeAssembly(topology, br_lengths)

# sigma FIXED to 1: BM rate and tree_length are confounded (data identify only their
# product), so sampling both gives a ridge -> non-convergent per-parameter R-hat. Fixing
# sigma = 1 lets the branch lengths (tree_length * rel_br_lengths) carry the trait variance
# directly, in units of sigma = 1. Topology posterior is unchanged; R-hat becomes meaningful.
sigma <- 1.0
traits ~ dnPhyloBrownianREML(phylogeny, branchRates = sigma, siteRates = 1.0, nSites = nC)
traits.clamp(data)

mymodel = model(phylogeny)
if (!exists("maxHours")) maxHours = 2
checkFreq = 200
paramFile = outPre + ".p.log"
monitors.append( mnScreen(printgen = 10000, sigma) )
monitors.append( mnModel(filename = paramFile, printgen = 10, stochasticOnly = TRUE, exclude = ["rel_br_lengths"]) )
monitors.append( mnFile(filename = outPre + ".trees", printgen = 10, phylogeny) )

mymc = mcmc(mymodel, monitors, moves, nruns = 2, combine = "none")
mymc.burnin(generations = 3000, tuningInterval = 200)

stopping_rules[1] = srMaxTime(maxHours, "hours")
stopping_rules[2] = srMinESS(333, paramFile, checkFreq, "ESS")
stopping_rules[3] = srGelmanRubin(1.01, paramFile, checkFreq)
mymc.run(rules = stopping_rules, checkpointFile = outPre + ".ckp", checkpointInterval = checkFreq)

t1 = readTreeTrace(outPre + "_run_1.trees", treetype = "non-clock", burnin = 0.25)
t2 = readTreeTrace(outPre + "_run_2.trees", treetype = "non-clock", burnin = 0.25)
mapTree(t1, file = outPre + "_map1.tre")
mapTree(t2, file = outPre + "_map2.tre")
q()
